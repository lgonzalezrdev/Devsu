{
  "info": {
    "_postman_id": "6139065d-7c38-45aa-83bb-02f6408d1cc1",
    "name": "Devsu - Reportes",
    "description": "Ejecuta la sincronización de Cuentas antes de consultar el reporte.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "servidor", "value": "localhost", "type": "string" },
    { "key": "puerto", "value": "7176", "type": "string" },
    { "key": "clienteId", "value": "REEMPLAZAR-POR-CLIENTE-ID", "type": "string" }
  ],
  "item": [
    {
      "name": "Estado de cuenta",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://{{servidor}}:{{puerto}}/api/reportes?fecha=2020-01-01%2000:00:00,2030-12-31%2023:59:59&cliente={{clienteId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));", "pm.test('Retorna cuentas', () => pm.expect(pm.response.json().cuentas).to.be.an('array'));"], "type": "text/javascript" } }]
    }
  ]
}
