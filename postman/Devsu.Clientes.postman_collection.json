    {
      "name": "Crear cliente",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('identificacionClientePrueba', `${Date.now()}`.slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));\nconst cliente = pm.response.json();\npm.test('Retorna el identificador del cliente', () => pm.expect(cliente.clienteId).to.be.a('string').and.not.empty);\npm.collectionVariables.set('clienteId', cliente.clienteId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luis Gonzalez\",\n  \"genero\": \"Masculino\",\n  \"edad\": 30,\n  \"identificacion\": \"{{identificacionClientePrueba}}\",\n  \"direccion\": \"Dirección de prueba\",\n  \"telefono\": \"0999999999\",\n  \"contrasena\": \"Prueba123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://{{servidor}}:{{puerto}}/api/clientes",
          "protocol": "http",
          "host": [
            "{{servidor}}"
          ],
          "port": "{{puerto}}",
          "path": [
            "api",
            "clientes"
          ]
        }
      },
      "response": []
