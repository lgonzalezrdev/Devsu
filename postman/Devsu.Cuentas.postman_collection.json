        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));\npm.test('Retorna movimientos paginados', () => { const respuesta = pm.response.json(); pm.expect(respuesta.elementos).to.be.an('array'); pm.expect(respuesta).to.have.property('totalRegistros'); pm.expect(respuesta).to.have.property('totalPaginas'); });"
            ]
          }
        }
      ],
